{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/q",
      "destination": "/?utm_source=qr_code&utm_medium=offline&utm_campaign=divulgacao",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/vendedores",
      "destination": "/vendedores/index.html"
    },
    {
      "source": "/barrakinha-x-ifood",
      "destination": "/barrakinha-x-ifood/index.html"
    },
    {
      "source": "/evento",
      "destination": "/evento/index.html"
    },
    {
      "source": "/e/:slug/totem",
      "destination": "/evento/index.html"
    },
    {
      "source": "/e/:slug",
      "destination": "/evento/index.html"
    },
    {
      "source": "/b/:slug/capa.png",
      "destination": "/api/og/:slug"
    },
    {
      "source": "/b/:slug",
      "destination": "/api/b/:slug"
    }
  ],
  "functions": {
    "api/og/[slug].js": {
      "includeFiles": "api/{_fonts,_assets}/**"
    }
  }
}
